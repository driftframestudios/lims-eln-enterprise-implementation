{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driftframe.example/contracts/promotion-receipt.v1.schema.json",
  "title": "Enterprise Implementation Promotion Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "promotion_receipt_id",
    "repository",
    "target_release",
    "promotion_state",
    "evidence_mode",
    "assurance_stage",
    "candidate_coordinate",
    "release_coordinate",
    "required_evidence",
    "limitations",
    "accountable_role",
    "metadata"
  ],
  "properties": {
    "$schema": {
      "const": "../contracts/promotion-receipt.v1.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "promotion_receipt_id": {
      "const": "RCP-IMPLEMENTATION-PROMOTION-003"
    },
    "repository": {
      "const": "driftframestudios/lims-eln-enterprise-implementation"
    },
    "target_release": {
      "const": "v0.3.1"
    },
    "promotion_state": {
      "const": "release_observed"
    },
    "evidence_mode": {
      "const": "observed"
    },
    "assurance_stage": {
      "const": "verified"
    },
    "candidate_coordinate": {
      "$ref": "#/$defs/candidateCoordinate"
    },
    "release_coordinate": {
      "$ref": "#/$defs/releaseCoordinate"
    },
    "required_evidence": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 20
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 20
      }
    },
    "accountable_role": {
      "type": "string",
      "minLength": 3
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "$defs": {
    "sha1Oid": {
      "type": "string",
      "pattern": "^(?!0{40}$)[a-f0-9]{40}$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[a-f0-9]{64}$"
    },
    "candidateCoordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "commit_oid",
        "tree_oid",
        "public_inspection_manifest_digest"
      ],
      "properties": {
        "release": {
          "const": "candidate-implementation-v0.3.1"
        },
        "commit_oid": {
          "$ref": "#/$defs/sha1Oid"
        },
        "tree_oid": {
          "$ref": "#/$defs/sha1Oid"
        },
        "public_inspection_manifest_digest": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "hostedCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "run_id",
        "conclusion"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "conclusion": {
          "const": "success"
        }
      }
    },
    "releaseCoordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_object_format",
        "tag",
        "tag_object_oid",
        "commit_oid",
        "tree_oid",
        "archive_format",
        "archive_digest",
        "promoted_at",
        "pull_request",
        "hosted_checks",
        "local_proof_receipt",
        "ruleset_receipt",
        "codeowner_resolution",
        "merge_signature_verification",
        "tag_signature_verification"
      ],
      "properties": {
        "git_object_format": {
          "const": "sha1"
        },
        "tag": {
          "const": "v0.3.1"
        },
        "tag_object_oid": {
          "$ref": "#/$defs/sha1Oid"
        },
        "commit_oid": {
          "$ref": "#/$defs/sha1Oid"
        },
        "tree_oid": {
          "$ref": "#/$defs/sha1Oid"
        },
        "archive_format": {
          "const": "git-tar"
        },
        "archive_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "promoted_at": {
          "type": "string",
          "format": "date-time"
        },
        "pull_request": {
          "const": 23
        },
        "hosted_checks": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/hostedCheck"
          }
        },
        "local_proof_receipt": {
          "$ref": "#/$defs/evidenceLocator"
        },
        "ruleset_receipt": {
          "$ref": "#/$defs/governedLocator"
        },
        "codeowner_resolution": {
          "$ref": "#/$defs/evidenceLocator"
        },
        "merge_signature_verification": {
          "const": "valid"
        },
        "tag_signature_verification": {
          "const": "valid"
        }
      }
    },
    "governedLocator": {
      "type": "string",
      "pattern": "^governed://[a-z0-9][a-z0-9._/-]*$"
    },
    "evidenceLocator": {
      "type": "string",
      "pattern": "^evidence://[a-z0-9][a-z0-9._/-]*$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "created_at",
        "updated_at",
        "owner"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor_id",
            "display_name",
            "role"
          ],
          "properties": {
            "actor_id": {
              "type": "string",
              "minLength": 3
            },
            "display_name": {
              "type": "string",
              "minLength": 3
            },
            "role": {
              "type": "string",
              "minLength": 3
            }
          }
        }
      }
    }
  }
}
