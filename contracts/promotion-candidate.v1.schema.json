{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driftframe.example/contracts/promotion-candidate.v1.schema.json",
  "title": "Enterprise Implementation Promotion Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "promotion_receipt_id",
    "repository",
    "target_release",
    "promotion_state",
    "evidence_mode",
    "assurance_stage",
    "candidate_coordinate",
    "prior_release_coordinate",
    "required_evidence",
    "remaining_promotion_evidence",
    "limitations",
    "accountable_role",
    "metadata"
  ],
  "properties": {
    "$schema": {
      "const": "../contracts/promotion-candidate.v1.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "promotion_receipt_id": {
      "const": "RCP-IMPLEMENTATION-PROMOTION-004"
    },
    "repository": {
      "const": "driftframestudios/lims-eln-enterprise-implementation"
    },
    "target_release": {
      "const": "v0.3.2"
    },
    "promotion_state": {
      "const": "release_candidate"
    },
    "evidence_mode": {
      "const": "observed"
    },
    "assurance_stage": {
      "const": "verified"
    },
    "candidate_coordinate": {
      "$ref": "#/$defs/candidateCoordinate"
    },
    "prior_release_coordinate": {
      "$ref": "#/$defs/priorReleaseCoordinate"
    },
    "required_evidence": {
      "$ref": "#/$defs/materialStatements"
    },
    "remaining_promotion_evidence": {
      "$ref": "#/$defs/materialStatements"
    },
    "limitations": {
      "$ref": "#/$defs/materialStatements"
    },
    "accountable_role": {
      "type": "string",
      "minLength": 3
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "$defs": {
    "sha1Oid": {
      "type": "string",
      "pattern": "^(?!0{40}$)[a-f0-9]{40}$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[a-f0-9]{64}$"
    },
    "candidateCoordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "repository_release",
        "public_inspection_manifest",
        "public_inspection_manifest_digest",
        "external_coordinate_manifest",
        "external_coordinate_manifest_digest",
        "selected_future_closure_digest"
      ],
      "properties": {
        "release": {
          "const": "candidate-implementation-v0.3.2"
        },
        "repository_release": {
          "const": "0.3.2"
        },
        "public_inspection_manifest": {
          "const": "release/public-inspection-manifest.json"
        },
        "public_inspection_manifest_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "external_coordinate_manifest": {
          "const": "release/external-contract-coordinates.json"
        },
        "external_coordinate_manifest_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "selected_future_closure_digest": {
          "const": "sha256:33bcc14da24309b7716728b3f0204008e8f7ebf58de75f9e40a5986b421f06b5"
        }
      }
    },
    "priorReleaseCoordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotion_receipt",
        "tag",
        "tag_object_oid",
        "commit_oid",
        "tree_oid",
        "archive_digest"
      ],
      "properties": {
        "promotion_receipt": {
          "const": "receipts/promotion-receipt.json"
        },
        "tag": {
          "const": "v0.3.1"
        },
        "tag_object_oid": {
          "$ref": "#/$defs/sha1Oid"
        },
        "commit_oid": {
          "$ref": "#/$defs/sha1Oid"
        },
        "tree_oid": {
          "$ref": "#/$defs/sha1Oid"
        },
        "archive_digest": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "materialStatements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 20
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "created_at",
        "updated_at",
        "owner"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor_id",
            "display_name",
            "role"
          ],
          "properties": {
            "actor_id": {
              "type": "string",
              "minLength": 3
            },
            "display_name": {
              "type": "string",
              "minLength": 3
            },
            "role": {
              "type": "string",
              "minLength": 3
            }
          }
        }
      }
    }
  }
}
