{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driftframestudios.example/contracts/runtime-setting-catalog.v1.schema.json",
  "title": "Runtime setting catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "aws_scope",
    "settings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "aws_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partition",
        "region",
        "account_id"
      ],
      "properties": {
        "partition": {
          "enum": [
            "aws",
            "aws-us-gov",
            "aws-cn"
          ]
        },
        "region": {
          "type": "string",
          "pattern": "^[a-z]{2}(-gov)?-[a-z]+-[0-9]$"
        },
        "account_id": {
          "type": "string",
          "pattern": "^[0-9]{12}$"
        }
      }
    },
    "settings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/configuration"
          },
          {
            "$ref": "#/$defs/secret"
          }
        ]
      }
    }
  },
  "$defs": {
    "common": {
      "type": "object",
      "required": [
        "logical_name",
        "classification",
        "source",
        "resource_arn",
        "cache_ttl_seconds"
      ],
      "properties": {
        "logical_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{2,127}$"
        },
        "resource_arn": {
          "type": "string",
          "minLength": 20
        },
        "cache_ttl_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "configuration": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "logical_name",
            "classification",
            "source",
            "resource_arn",
            "cache_ttl_seconds"
          ],
          "properties": {
            "logical_name": true,
            "classification": {
              "const": "configuration"
            },
            "source": {
              "const": "parameter_store"
            },
            "resource_arn": {
              "type": "string",
              "pattern": "^arn:aws(-us-gov|-cn)?:ssm:[^:]+:[0-9]{12}:parameter/.+$"
            },
            "cache_ttl_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600
            },
            "parameter_version": {
              "type": "integer",
              "minimum": 1
            },
            "parameter_label": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,100}$"
            }
          },
          "oneOf": [
            {
              "required": [
                "parameter_version"
              ]
            },
            {
              "required": [
                "parameter_label"
              ]
            },
            {
              "properties": {
                "parameter_version": false,
                "parameter_label": false
              }
            }
          ]
        }
      ]
    },
    "secret": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "logical_name",
            "classification",
            "source",
            "resource_arn",
            "cache_ttl_seconds"
          ],
          "properties": {
            "logical_name": true,
            "classification": {
              "const": "secret"
            },
            "source": {
              "const": "secrets_manager"
            },
            "resource_arn": {
              "type": "string",
              "pattern": "^arn:aws(-us-gov|-cn)?:secretsmanager:[^:]+:[0-9]{12}:secret:.+$"
            },
            "cache_ttl_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 900
            },
            "secret_version_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{32,64}$"
            },
            "secret_version_stage": {
              "type": "string",
              "pattern": "^[A-Za-z0-9/_+=.@-]{1,256}$"
            }
          }
        }
      ]
    }
  }
}
