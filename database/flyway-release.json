{
  "schema_version": "1.1.0",
  "engine": "postgresql",
  "migration_product": "Flyway Community",
  "flyway_version": "13.0.0",
  "container_image": "flyway/flyway:13.0.0-alpine@sha256:f3c8433401abf859ef9022584c8e6111684363ec490f737e749e9a4705ea32d0",
  "configuration": "flyway.conf",
  "locations": [
    "filesystem:sql"
  ],
  "deployment_cadence": "independent_from_application_releases",
  "versioning": {
    "legacy_versions": "V001-through-V004",
    "successor_format": "VyyyyMMddHHmmss__description.sql",
    "clock": "UTC",
    "out_of_order": true
  },
  "authenticated_login": "laboratory_migrator",
  "migration_role": "laboratory_owner",
  "connection_callback": "sql/afterConnect.sql",
  "cluster_role_provisioning": "database/provision_cluster_roles.sql",
  "baseline_policy": "explicit_attested_baseline_only",
  "cross_service_events": {
    "pattern": "transactional_outbox",
    "capture": "Debezium Outbox Event Router",
    "configuration": "infra/debezium/outbox-event-router.properties"
  },
  "credentials": "runtime_environment_only"
}
