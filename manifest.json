{
  "schema_version": "2.1.0",
  "name": "lims-eln-enterprise-implementation",
  "version": "0.4.0",
  "python": ">=3.12",
  "repository_role": "enterprise_implementation",
  "fixture_policy": "synthetic_only",
  "machine_node": {
    "path": "machine-node.json",
    "mode": "documentation_only"
  },
  "runtime_configuration": {
    "library": "AWS Lambda Powertools Parameters",
    "configuration_source": "aws_systems_manager_parameter_store",
    "secret_source": "aws_secrets_manager",
    "credential_source": "workload_identity"
  },
  "database": {
    "engine": "postgresql",
    "qualified_major": 17,
    "migration_product": "Flyway Community",
    "migration_product_version": "13.0.0",
    "migration_configuration": "flyway.conf",
    "migration_deployment_cadence": "independent_from_application_releases",
    "tenant_scope": "transaction_local_application_tenant_after_authentication",
    "cross_service_events": "debezium_outbox_event_router"
  },
  "vendor_exemplars": [
    "LabKey JSON API",
    "vendor-neutral revisioned gateway"
  ]
}
